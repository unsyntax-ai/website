  "metadata": {
    "version": "1.0.0",
    "last_updated": "2024-02-18",
    "description": "Centralized image configuration for all pages and sections. Update image URLs here to change them across the site.",
    "usage_instructions": [
      "1. Locate the page you want to update in the 'pages' object",
      "2. Find the section within that page",
      "3. Update the 'image' URL with your new image",
      "4. Update the 'alt' text for accessibility",
      "5. Save the file and the changes will be reflected on the site",
      "6. For portfolio and blog images, refer to portfolio_items.json and blogs.csv respectively"
    ],
